# Copy to .env at repository root. Root commands load this file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_sprout
PORT=3000
# Native only: use your computer's LAN address, not localhost on a phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# HTTP tests create disposable child profiles in the configured development DB.
TEST_API_URL=http://127.0.0.1:3000/api
